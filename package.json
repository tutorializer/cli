{
  "name": "tutorializer",
  "version": "1.1.0",
  "private": false,
  "description": "tutorializer cli to manage speeches, videos, tutorials and more",
  "license": "Apache-2.0",
  "repository": "github:tutorializer/cli",
  "homepage": "https://www.tutorializer.com/developers/",
  "author": "Tutorializer",
  "type": "commonjs",
  "main": "./dist/index.js",
  "bin": {
    "tutorializer": "./dist/index.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "develop": "node index.js",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:repo": "node scripts/publishCli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "keywords": [
    "tutorials",
    "speeches",
    "videos"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "fs-extra": "10.1.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1"
  },
  "devDependencies": {
    "@monorepool/agentfirst": "0.0.0",
    "@tutorializer/client": "0.0.0",
    "esbuild": "0.25.4",
    "eslint": "10.8.0"
  }
}
