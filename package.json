{
  "name": "tutorializer",
  "version": "1.3.0",
  "private": false,
  "description": "tutorializer cli to manage speeches, videos, tutorials and more",
  "license": "Apache-2.0",
  "repository": "github:tutorializer/cli",
  "homepage": "https://www.tutorializer.com/developers/",
  "author": "Tutorializer",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "bin": {
    "tutorializer": "./bin/tutorializer.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "develop": "node index.js",
    "prepublishOnly": "npm run build",
    "publish:npm": "npm publish --access public",
    "publish:repo": "node scripts/publishCli.mjs",
    "test:smoke": "node scripts/build.js && node --check dist/index.js && node dist/index.js --version"
  },
  "files": [
    "bin",
    "dist",
    "skills"
  ],
  "keywords": [
    "tutorials",
    "speeches",
    "videos",
    "cli"
  ],
  "dependencies": {
    "commander": "8.3.0",
    "fs-extra": "10.1.0",
    "inquirer": "8.2.5",
    "node-localstorage": "2.2.1"
  },
  "devDependencies": {
    "@monorepool/agentfirst": "0.0.0",
    "@tutorializer/client": "0.0.0",
    "esbuild": "0.25.4"
  }
}
